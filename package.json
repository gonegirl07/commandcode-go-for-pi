{
  "name": "commandcode-go-for-pi",
  "version": "0.1.0",
  "description": "A single Pi extension for Command Code Go/GOAT models, reasoning controls, a live quota bar, and usage reporting.",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "commandcode",
    "go",
    "goat",
    "usage"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gonegirl07/commandcode-go-for-pi.git"
  },
  "homepage": "https://github.com/gonegirl07/commandcode-go-for-pi#readme",
  "bugs": {
    "url": "https://github.com/gonegirl07/commandcode-go-for-pi/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "index.ts",
    "omp",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.2 <1",
    "@earendil-works/pi-coding-agent": ">=0.84.2 <1"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "typescript": "^5.9.2"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "omp": {
    "extensions": [
      "omp/commandcode-quota.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.mjs"
  }
}
